# Copy to .env for local development. NEVER commit .env or real secrets.
# Local development uses config.settings.local (see src/manage.py).
# Production uses config.settings.production (see src/config/wsgi.py) and requires
# every variable marked [production-required].

# --- Core ---------------------------------------------------------------
# Local only. Generate a real value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=local-development-only-change-me
# Comma separated previous keys, used only during a controlled key rotation.
SECRET_KEY_FALLBACKS=
DEBUG=true
LOG_LEVEL=INFO

# --- Hosts and URLs -----------------------------------------------------
# [production-required] exact host names, comma separated, no wildcard
ALLOWED_HOSTS=localhost,127.0.0.1
# [production-required] comma separated https origins
CSRF_TRUSTED_ORIGINS=
# [production-required] canonical public URL, https, no trailing slash
SITE_URL=http://127.0.0.1:8000
# URL prefix of the Django admin (end with a slash). Not a security control.
ADMIN_URL=admin/

# --- Database -----------------------------------------------------------
# Local default: SQLite. [production-required] PostgreSQL, e.g.
#   postgresql://USER:PASSWORD@db:5432/oderske_chasy?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# --- Storage (private files are never served from a public URL) ----------
GALLERY_ROOT=./var/gallery
SHEET_MUSIC_ROOT=./var/sheet_music
MAX_SHEET_MUSIC_BYTES=15728640
MAX_IMAGE_BYTES=10485760

# --- Email ---------------------------------------------------------------
# Local default prints emails to the console. Production uses SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Oderské chasy <web@example.invalid>

# --- Contacts (placeholders, replace with real operator values) ----------
ADMIN_CONTACT_EMAIL=admin@example.invalid
PRIVACY_CONTACT_EMAIL=gdpr@example.invalid
SECURITY_CONTACT_EMAIL=security@example.invalid
CONTACT_RECIPIENT_EMAIL=kapela@example.invalid
CONTACT_RETENTION_DAYS=90

# --- Production transport security --------------------------------------
# Redirect HTTP to HTTPS inside Django (set false only if the proxy already redirects).
SECURE_SSL_REDIRECT=true
# Trust X-Forwarded-Proto from the reverse proxy. Enable ONLY behind a proxy that
# overwrites this header.
TRUST_PROXY_SSL_HEADER=true
# Number of reverse proxies in front of the app (used for login rate limiting).
PROXY_COUNT=1
# HSTS rollout: start with 3600, then 86400, 604800, 31536000 (see docs/deployment.md).
HSTS_SECONDS=3600
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# --- Docker Compose (compose.yaml) --------------------------------------
POSTGRES_DB=oderske_chasy
POSTGRES_USER=oderske_chasy
POSTGRES_PASSWORD=change-me-locally
